# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# React Native Firebase exige frameworks estáticos no iOS.
$RNFirebaseAsStaticFramework = true
# O SDK do Firebase vem pelo CocoaPods: via SPM (padrão do RN Firebase) cada pod embute sua própria
# cópia do Firebase, o que gera símbolos duplicados com frameworks estáticos.
$RNFirebaseDisableSPM = true
use_frameworks! :linkage => :static

target 'app_seeflex_exemplo' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Fix for Xcode 26.4 build error
    installer.pods_project.targets.each do |target|
      if target.name == 'fmt'
        target.build_configurations.each do |config|
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end

    # Alguns pods do Firebase (bundles de privacidade do GoogleUtilities, nanopb, PromisesObjC...) declaram
    # iOS 9/12, abaixo do mínimo aceito pelo Xcode atual - nivela todos ao mínimo do React Native.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < min_ios_version_supported.to_f
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
        end
      end
    end
  end
end
